RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.stackcode\.com\.br$ [NC]
RewriteRule ^(.*)$ https://stackcode.com.br/$1 [L,R=301]

RewriteRule ^automacoes/?$ https://automacoes.stackcode.com.br/ [L,R=301]
RewriteRule ^automacoes/(.*)$ https://automacoes.stackcode.com.br/$1 [L,R=301]

ErrorDocument 404 /404.html
